# Copy to .env and `set -a; . ./.env; set +a` before `node dist/server.js`.
BRIDGE_PORT=8787
BRIDGE_HOST=0.0.0.0
# Required: openssl rand -hex 32
BRIDGE_TOKEN=dev-token-change-me
# Every workspace the client may open must live under this directory.
PI_ALLOWED_ROOT=$HOME/projects
BRIDGE_DATA_DIR=./data
IDLE_TIMEOUT_MS=1200000
BRIDGE_HISTORY_LIMIT=500
