# /home/<user>/.config/pi-home-bridge.env
# Loaded by pi-home-bridge@<user>.service — chmod 600.

BRIDGE_PORT=8787
BRIDGE_HOST=0.0.0.0
# Required. Generate with: openssl rand -hex 32
BRIDGE_TOKEN=replace-me-with-a-long-random-secret

# Every workspace the phone may open must live under this directory.
PI_ALLOWED_ROOT=/home/<user>/projects

# Bridge bookkeeping (sessions.json + pi session files).
BRIDGE_DATA_DIR=/home/<user>/pi-home-bridge/data
PI_SESSION_DIR=/home/<user>/pi-home-bridge/data/pi-sessions

# Idle eviction for child processes (ms). 1200000 = 20 minutes.
IDLE_TIMEOUT_MS=1200000
BRIDGE_HISTORY_LIMIT=500
SHUTDOWN_GRACE_MS=3000

# Absolute path to the pi CLI; `pi` is fine when it is on PATH for this user.
PI_CLI=/home/<user>/.pi/agent/bin/pi
